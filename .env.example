# Server & Application URL
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# SQLite Database Configuration
SQLITE_DB_PATH="./database/smartcred.db"
# Set ENABLE_DEMO_SEED="false" in production to disable automatic demo account creation
ENABLE_DEMO_SEED="true"

# JWT & Cryptographic Security Secrets (Replace in production)
JWT_ACCESS_SECRET="replace-with-strong-64-char-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-64-char-refresh-secret"
CSRF_SECRET="replace-with-strong-csrf-hmac-secret"
QR_HMAC_SECRET="replace-with-strong-qr-verification-secret"

# Email Notifications (Nodemailer SMTP) - Leave empty for labelled Demo Simulation Mode
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="SmartCred Notifications <no-reply@smartcred.demo>"

# SMS Notifications (Twilio) - Leave empty for labelled Demo Simulation Mode
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WhatsApp Business Cloud API - Leave empty for labelled Demo Simulation Mode
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# AI Studio Runtime Environment Variable
GEMINI_API_KEY="MY_GEMINI_API_KEY"

